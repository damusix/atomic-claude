#!/usr/bin/env bash
# Pre-commit hook:
#   Stage 1 — render templates when a staged change touches templates/.
#              Re-stages the context/commands/ and context/agents/ outputs so
#              they ride along with this commit.
#   Stage 2 — regenerate followups INDEX.md when a staged change touches
#              .claude/project/followups/ entry files (excluding INDEX.md).
#              Degrades to WARN if atomic binary is absent.
#   Stage 3 — rebuild internal/serve/frontend/dist when a staged change
#              touches the frontend workspace (excluding dist/ itself).
#              Degrades to WARN if bun is absent.
#
# There is no bundle stage: atomic/internal/embedded/ is gitignored and
# regenerated by `make -C atomic bundle` (a prerequisite of build/test/vet),
# by `go generate ./...` in CI, and by goreleaser's before-hook.
# Installed by `make hooks` (sets core.hooksPath=.githooks).
set -euo pipefail

# Only react to staged changes (ignore unstaged edits — they aren't part of
# this commit).
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)

repo_root=$(git rev-parse --show-toplevel)

# --- Stage 1: render templates ---
needs_render=0
for f in "${staged[@]}"; do
    case "$f" in
        templates/*)
            needs_render=1
            break
            ;;
    esac
done

if [ "$needs_render" -eq 1 ]; then
    echo "pre-commit: templates changed — running make render"
    make -C "$repo_root" render >/dev/null
    # Re-stage rendered outputs so they ride along with this commit.
    git add "$repo_root/context/commands" "$repo_root/context/agents"
    echo "pre-commit: rendered outputs re-staged"

    # The render stage may have re-staged files; refresh the staged list so the
    # stages below see the updated set.
    mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
fi

# --- Stage 2: regenerate follow-ups index ---
# Regenerate follow-ups INDEX.md when any entry file (other than INDEX.md
# itself) is staged. Skips silently if the atomic binary is not on PATH —
# fresh clones and pre-install states should commit without failing.
followups_touched=0
for f in "${staged[@]}"; do
    case "$f" in
        .claude/project/followups/INDEX.md) ;;
        .claude/project/followups/*.md)
            followups_touched=1
            break
            ;;
    esac
done

if [ "$followups_touched" -eq 1 ]; then
    if command -v atomic >/dev/null 2>&1; then
        atomic followups render >/dev/null
        git add "$repo_root/.claude/project/followups/INDEX.md"
        echo "pre-commit: follow-ups INDEX.md regenerated and re-staged"
    else
        echo "pre-commit: atomic binary not on PATH; skipping follow-ups INDEX regen" >&2
    fi
fi

# --- Stage 3: rebuild frontend dist ---
frontend_touched=0
for f in "${staged[@]}"; do
    case "$f" in
        atomic/internal/serve/frontend/dist/*) ;;
        atomic/internal/serve/frontend/*)
            frontend_touched=1
            break
            ;;
    esac
done

if [ "$frontend_touched" -eq 1 ]; then
    if command -v bun >/dev/null 2>&1; then
        echo "pre-commit: frontend workspace changed — running make frontend"
        make -C "$repo_root/atomic" frontend >/dev/null
        git add "$repo_root/atomic/internal/serve/frontend/dist"
        echo "pre-commit: frontend dist rebuilt and re-staged"
    else
        echo "pre-commit: bun not on PATH; skipping frontend dist rebuild" >&2
    fi
fi

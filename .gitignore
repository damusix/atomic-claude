# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Throwaway scratch (kept gitignored), except for Docker eval scaffold dirs.
tmp/*
!tmp/workspace/
tmp/workspace/*
!tmp/workspace/.gitkeep
!tmp/claude-home/
tmp/claude-home/*
!tmp/claude-home/.gitkeep
.worktrees/
/bin/
node_modules/
.vitepress/dist/
.vitepress/cache/

# tree-sitter grammar sources: build-time input for lib/ts.wasm, fetched on demand
# via atomic/internal/codeintel/tsbinding/fetch-grammars.sh (see that dir's CLAUDE.md).
# The committed lib/ts.wasm is the runtime artifact; these C sources are not committed.
atomic/internal/codeintel/tsbinding/src/
.claude/.atomic-index/

# Embedded artifact bundle: a build artifact, not a source. go:embed cannot
# reach ../../../context (invalid pattern) and will not follow a symlink, so
# the context/ tree is mirrored into the package at build time. Regenerated by
# `make -C atomic bundle`, and by `go generate ./...` in CI and goreleaser's
# before-hook, so no shipped binary depends on it being committed.
atomic/internal/embedded/bundle/
atomic/internal/embedded/manifest.go

# demo video recordings (marketing/demo/run.mjs)
marketing/demo/out/

# atomic serve frontend build output — rebuilt by `make -C atomic frontend`
# (a prerequisite of build/test/vet) and by `go generate ./...` in CI and goreleaser.
atomic/internal/serve/frontend/dist/
